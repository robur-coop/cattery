opam-version: "2.0"
name:         "cattery"
maintainer:   "Romain Calascibetta <romain.calascibetta@gmail.com>"
authors:      "Romain Calascibetta <romain.calascibetta@gmail.com>"
homepage:     "https://github.com/robur-coop/cattery"
bug-reports:  "https://github.com/robur-coop/cattery/issues"
dev-repo:     "git+https://github.com/robur-coop/cattery.git"
doc:          "https://docs.osau.re/miou/"
license:      "ISC"
synopsis:     "A pool for Miou"

build: [ "dune" "build" "-p" name "-j" jobs ]
run-test: [ "dune" "runtest" "-p" name "-j" jobs ]

depends: [
  "ocaml"             {>= "5.0.0"}
  "dune"              {>= "2.8.0"}
  "miou"
  "fmt"
]
x-maintenance-intent: [ "(latest)" ]
